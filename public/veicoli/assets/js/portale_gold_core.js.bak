        // --- GESTIONE SPARKLINE ---
        function DisegnaSparkline() {
            var canvas = document.getElementById('sparklineCanvas');
            if(!canvas) return;
            var ctx = canvas.getContext('2d');
            var w = canvas.width;
            var h = canvas.height;
            
            // Genera dati casuali realistici (trend crescente)
            var data = [10, 15, 12, 18, 22, 20, 25, 30, 28, 35];
            var max = 40;
            var min = 0;
            
            ctx.clearRect(0, 0, w, h);
            
            var stepX = w / (data.length - 1);
            
            // Draw Gradient Fill
            var gradient = ctx.createLinearGradient(0, 0, 0, h);
            gradient.addColorStop(0, "rgba(212, 175, 55, 0.4)");
            gradient.addColorStop(1, "rgba(212, 175, 55, 0.0)");
            
            ctx.beginPath();
            ctx.moveTo(0, h);
            for(var i = 0; i < data.length; i++) {
                var x = i * stepX;
                var y = h - ((data[i] - min) / (max - min) * (h - 5));
                if(i===0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.lineTo(w, h);
            ctx.closePath();
            ctx.fillStyle = gradient;
            ctx.fill();
            
            // Draw Line
            ctx.beginPath();
            for(var i = 0; i < data.length; i++) {
                var x = i * stepX;
                var y = h - ((data[i] - min) / (max - min) * (h - 5));
                if(i===0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.strokeStyle = "#d4af37";
            ctx.lineWidth = 2;
            ctx.lineCap = "round";
            ctx.lineJoin = "round";
            ctx.stroke();
            
            // Draw End Point
            var lastX = w;
            var lastY = h - ((data[data.length-1] - min) / (max - min) * (h - 5));
            ctx.beginPath();
            ctx.arc(lastX - 2, lastY, 3, 0, 2 * Math.PI);
            ctx.fillStyle = "#fff";
            ctx.fill();
            ctx.lineWidth = 1;
            ctx.strokeStyle = "#d4af37";
            ctx.stroke();
        }

