<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Progetto Gioco - Monitoraggio</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-color: #0f172a;
            --panel-bg: rgba(30, 41, 59, 0.7);
            --primary: #10b981;
            --primary-glow: rgba(16, 185, 129, 0.4);
            --danger: #ef4444;
            --danger-glow: rgba(239, 68, 68, 0.4);
            --accent: #8b5cf6;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --gold: #fbbf24;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(16, 185, 129, 0.15) 0%, transparent 50%);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        .header {
            padding: 2rem;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        h1 {
            font-family: 'Outfit', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            letter-spacing: -1px;
            background: linear-gradient(to right, #fff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-flex;
            align-items: center;
            gap: 15px;
        }

        h1 i {
            color: var(--gold);
            -webkit-text-fill-color: initial;
            filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.5));
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
            flex: 1;
            display: grid;
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        @media (min-width: 900px) {
            .container {
                grid-template-columns: 1fr 1fr;
            }
        }

        .glass-panel {
            background: var(--panel-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2rem;
            backdrop-filter: blur(12px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .glass-panel:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .stats-grid {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 1.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 4px;
        }

        .stat-card.spent::before { background: var(--danger); box-shadow: 0 0 15px var(--danger-glow); }
        .stat-card.won::before { background: var(--primary); box-shadow: 0 0 15px var(--primary-glow); }
        .stat-card.net::before { background: var(--accent); box-shadow: 0 0 15px rgba(139, 92, 246, 0.6); }

        .stat-label {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .stat-value {
            font-family: 'Outfit', sans-serif;
            font-size: 2.5rem;
            font-weight: 800;
            transition: color 0.3s ease;
        }

        h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        input[type="number"], input[type="text"], input[type="datetime-local"], select {
            width: 100%;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            padding: 12px 15px;
            border-radius: 10px;
            font-size: 1rem;
            outline: none;
            transition: all 0.3s ease;
            color-scheme: dark;
        }

        input:focus, select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.25);
        }

        /* Nasconde le freccine dei campi numerici */
        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }

        .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-add {
            background: linear-gradient(135deg, var(--accent), #6d28d9);
            color: white;
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
        }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.6);
        }

        .history-list {
            list-style: none;
            margin-top: 1.5rem;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .history-list::-webkit-scrollbar {
            width: 6px;
        }
        .history-list::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
        }

        .history-item {
            background: rgba(0, 0, 0, 0.2);
            border-left: 4px solid var(--text-muted);
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            animation: slideIn 0.3s ease-out forwards;
        }

        .history-item.profit { border-color: var(--primary); }
        .history-item.loss { border-color: var(--danger); }
        .history-item.neutral { border-color: var(--gold); }

        .history-info strong {
            display: block;
            font-size: 1.1rem;
            margin-bottom: 3px;
        }

        .history-info span {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .history-amounts {
            text-align: right;
        }

        .amt-net {
            font-weight: 800;
            font-family: 'Outfit', sans-serif;
            font-size: 1.2rem;
        }

        .amt-net.positive { color: var(--primary); }
        .amt-net.negative { color: var(--danger); }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(-20px); }
            to { opacity: 1; transform: translateX(0); }
        }
        
        .type-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: bold;
            margin-left: 8px;
            vertical-align: middle;
        }
        .badge-superenalotto { background: #0284c7; color: white; }
        .badge-lotto { background: #10b981; color: white; }
        .badge-gratta { background: #ea580c; color: white; }

        .slot-container {
            display: flex;
            gap: 10px;
            margin: 15px 0;
            justify-content: center;
        }
        .slot-number {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--accent), #6d28d9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(139, 92, 246, 0.4);
            transition: transform 0.2s;
        }
        .slot-number.spinning {
            animation: spin 0.1s infinite linear;
        }
        @keyframes spin {
            0% { transform: translateY(-5px); opacity: 0.8; }
            50% { transform: translateY(5px); opacity: 1; }
            100% { transform: translateY(-5px); opacity: 0.8; }
        }

        .tabs {
            display: flex;
            margin-bottom: 1.5rem;
            background: rgba(0,0,0,0.2);
            border-radius: 10px;
            padding: 5px;
        }
        .tab {
            flex: 1;
            text-align: center;
            padding: 10px;
            cursor: pointer;
            border-radius: 6px;
            font-weight: 600;
            transition: background 0.3s;
        }
        .tab.active {
            background: var(--accent);
            color: white;
            box-shadow: 0 2px 10px rgba(139, 92, 246, 0.3);
        }

    </style>
</head>
<body>

    <header class="header">
        <h1><i class="fa-solid fa-clover"></i> Progetto Gioco Live</h1>
        <p style="color: var(--text-muted); margin-top: 5px;">Monitoraggio Statistico SuperEnalotto e Gratta & Vinci</p>
        <div style="margin-top: 15px;">
            <select id="globalYearFilter" onchange="updateDashboard()" style="width: auto; padding: 5px 15px; font-size: 1rem; border-radius: 20px; background: rgba(0,0,0,0.5); color: white; border: 1px solid var(--accent); cursor: pointer; outline: none;">
            </select>
        </div>
    </header>

    <div class="container">
        
        <div class="glass-panel" style="grid-column: 1 / -1; padding: 1.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: -1rem;">
            <div style="display: flex; align-items: center; gap: 15px;">
                <h3 style="margin: 0; font-size: 1.1rem;"><i class="fa-solid fa-bullseye" style="color: var(--gold);"></i> Budget Mensile:</h3>
                <input type="number" id="inpBudget" style="width: 100px; padding: 8px; font-size: 1rem; margin: 0; text-align:center;" onchange="saveBudget()" title="Imposta budget mensile">
            </div>
            <div style="flex: 1; min-width: 250px; margin-left: 20px; margin-top: 10px;">
                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 5px; font-weight: 600;">
                    <span id="budgetText">Spesa: 0€ / 50€</span>
                    <span id="budgetPercent">0%</span>
                </div>
                <div style="width: 100%; height: 10px; background: rgba(0,0,0,0.4); border-radius: 5px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
                    <div id="budgetBar" style="width: 0%; height: 100%; background: var(--primary); transition: width 0.3s, background 0.3s;"></div>
                </div>
            </div>
        </div>
        <div class="stats-grid">
            <div class="stat-card spent">
                <div class="stat-label">Totale Speso</div>
                <div class="stat-value" id="valSpent">€ 0,00</div>
            </div>
            <div class="stat-card won">
                <div class="stat-label">Totale Vinto</div>
                <div class="stat-value" id="valWon">€ 0,00</div>
            </div>
            <div class="stat-card net">
                <div class="stat-label">Bilancio Netto</div>
                <div class="stat-value" id="valNet">€ 0,00</div>
            </div>
        </div>

        <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-top: -1rem;">
            <div class="stat-card" style="padding: 1rem;">
                <div class="stat-label">ROI (Ritorno)</div>
                <div class="stat-value" id="valROI" style="font-size: 1.8rem;">0%</div>
            </div>
            <div class="stat-card" style="padding: 1rem;">
                <div class="stat-label">Vincita più alta</div>
                <div class="stat-value" id="valMaxWin" style="font-size: 1.8rem;">€ 0,00</div>
            </div>
            <div class="stat-card" style="padding: 1rem;">
                <div class="stat-label">Spesa SuperEnalotto</div>
                <div class="stat-value" id="valSpesaSE" style="font-size: 1.8rem; color: #0284c7">€ 0,00</div>
            </div>
            <div class="stat-card" style="padding: 1rem;">
                <div class="stat-label">Spesa Lotto</div>
                <div class="stat-value" id="valSpesaLotto" style="font-size: 1.8rem; color: #10b981">€ 0,00</div>
            </div>
            <div class="stat-card" style="padding: 1rem;">
                <div class="stat-label">Striscia Vincente</div>
                <div class="stat-value" id="valStreak" style="font-size: 1.8rem; color: var(--gold)">🔥 0</div>
            </div>
            <div class="stat-card" style="padding: 1rem;">
                <div class="stat-label">Spesa Gratta & Vinci</div>
                <div class="stat-value" id="valSpesaGV" style="font-size: 1.8rem; color: #ea580c">€ 0,00</div>
            </div>
        </div>

        <div class="glass-panel" style="grid-column: 1 / -1; padding-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div>
                    <h2 style="margin-bottom: 5px;"><i class="fa-solid fa-chart-line" style="color: var(--accent);"></i> Andamento Bilancio Netto</h2>
                </div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button class="btn" style="background: rgba(255,255,255,0.1); color: white; width: auto; font-size: 0.85rem; padding: 8px 12px;" onclick="generateRecap()"><i class="fa-solid fa-file-lines"></i> Riassunto Mese</button>
                    <button class="btn" style="background: rgba(255,255,255,0.1); color: white; width: auto; font-size: 0.85rem; padding: 8px 12px;" onclick="exportData()"><i class="fa-solid fa-download"></i> Esporta</button>
                    <label class="btn" style="background: rgba(255,255,255,0.1); color: white; width: auto; font-size: 0.85rem; padding: 8px 12px; cursor: pointer;">
                        <i class="fa-solid fa-upload"></i> Importa
                        <input type="file" id="importFile" style="display: none;" accept=".json" onchange="importData(event)">
                    </label>
                </div>
            </div>
            <div style="height: 300px; width: 100%; margin-top: 1rem;">
                <canvas id="balanceChart"></canvas>
            </div>
        </div>

        <div class="glass-panel">
            <h2><i class="fa-solid fa-plus-circle" style="color: var(--accent);"></i> Inserisci Giocata</h2>
            
            <div class="tabs">
                <div class="tab active" onclick="setGameType('SuperEnalotto')" id="tabSuper">SuperEnalotto</div>
                <div class="tab" onclick="setGameType('Lotto')" id="tabLotto">Lotto</div>
                <div class="tab" onclick="setGameType('Gratta e Vinci')" id="tabGratta">Gratta & Vinci</div>
            </div>

            <div id="generatorBox" style="background: rgba(0,0,0,0.2); padding: 15px; border-radius: 10px; margin-bottom: 15px; text-align: center;">
                <button type="button" class="btn" style="background: linear-gradient(135deg, var(--gold), #d97706); color: #0f172a; width: auto; display: inline-block; padding: 10px 20px; font-size: 0.95rem; font-weight: 800; box-shadow: 0 4px 15px rgba(251, 191, 36, 0.4);" onclick="generateNumbers()">
                    <i class="fa-solid fa-dice"></i> Genera Numeri Fortunati
                </button>
                <div id="slotNumbers" class="slot-container" style="display:none;"></div>
            </div>

            <form id="gameForm">
                <div class="input-group">
                    <label>Data e Ora</label>
                    <input type="datetime-local" id="inpDate" required>
                </div>
                <div class="input-group">
                    <label>Descrizione (Opzionale)</label>
                    <input type="text" id="inpDesc" placeholder="Es. Il Miliardario, Sestina...">
                </div>
                <div class="input-group">
                    <label>Importo Speso (€)</label>
                    <input type="number" id="inpCost" step="0.50" min="0" required placeholder="0.00">
                </div>
                <div class="input-group">
                    <label>Importo Vinto (€)</label>
                    <input type="number" id="inpWin" step="0.50" min="0" value="0" required>
                </div>
                <button type="submit" class="btn btn-add"><i class="fa-solid fa-save"></i> Registra Giocata</button>
            </form>
        </div>

        <div class="glass-panel">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-bottom: 1.5rem;">
                <h2 style="margin-bottom: 0;"><i class="fa-solid fa-history" style="color: var(--primary);"></i> Cronologia</h2>
                <div style="display: flex; gap: 10px;">
                    <select id="filterType" onchange="renderHistory()" style="padding: 5px; font-size: 0.85rem; width: auto;">
                        <option value="all">Tutti i giochi</option>
                        <option value="SuperEnalotto">Solo SuperEnalotto</option>
                        <option value="Lotto">Solo Lotto</option>
                        <option value="Gratta e Vinci">Solo Gratta & Vinci</option>
                    </select>
                </div>
            </div>
            <ul class="history-list" id="historyList">
                <!-- Items verranno iniettati via JS -->
            </ul>
        </div>
        <div class="glass-panel" style="margin-top: 2rem;">
            <h2><i class="fa-solid fa-chart-pie" style="color: var(--accent);"></i> Probabilità Ufficiali Gratta e Vinci</h2>
            <div style="font-size: 0.95rem; color: #cbd5e1; line-height: 1.6;">
                <p style="margin-bottom: 1rem;"><strong>Regola Aurea:</strong> 1 biglietto ogni 3,5 è "vincente" in media, ma questo include i premi uguali al costo della giocata. Se cerchi vincite superiori al costo, le probabilità si abbassano drasticamente.</p>
                <div style="background: rgba(0,0,0,0.3); border-left: 3px solid #0284c7; padding: 10px 15px; margin-bottom: 1rem; border-radius: 6px;">
                    <h4 style="color: white; margin-bottom: 5px;">Migliori per Probabilità di VINCITA REALE (premio > costo):</h4>
                    <ul style="margin-left: 20px; list-style-type: circle;">
                        <li><strong>Vinci in Grande (25€)</strong>: ~1 su 4,03 (24.8%)</li>
                        <li><strong>Il Miliardario Maxi (20€)</strong>: ~1 su 4,14 (24.1%)</li>
                        <li><strong>100X (20€)</strong>: ~1 su 4,14 (24.1%)</li>
                    </ul>
                </div>
                <div style="background: rgba(0,0,0,0.3); border-left: 3px solid #ea580c; padding: 10px 15px; margin-bottom: 1rem; border-radius: 6px;">
                    <h4 style="color: white; margin-bottom: 5px;">Probabilità Premio Massimo (es. Il Miliardario):</h4>
                    <ul style="margin-left: 20px; list-style-type: circle;">
                        <li><strong>5.000.000€</strong> (Miliardario Maxi): 1 su 9.360.000</li>
                        <li><strong>2.000.000€</strong> (Miliardario Classico): 1 su 7.800.000</li>
                    </ul>
                </div>
                <p style="font-size: 0.85rem; color: #94a3b8; font-style: italic;">Nota: Questi dati sono stime ufficiali ADM. Gioca sempre responsabilmente. Il banco ha un vantaggio matematico, quindi a lungo termine l'esito netto atteso è negativo.</p>
            </div>
        </div>

    </div>

    <script>
        // Stato Applicazione
        let currentGame = 'SuperEnalotto';
        let records = JSON.parse(localStorage.getItem('gioco_records')) || [];
        let editingTimestamp = null;
        let balanceChart = null;
        let monthlyBudget = localStorage.getItem('gioco_budget') || 50;

        // Inizializza input budget
        document.addEventListener('DOMContentLoaded', () => {
            const inpBudget = document.getElementById('inpBudget');
            if(inpBudget) inpBudget.value = monthlyBudget;
        });

        function saveBudget() {
            monthlyBudget = document.getElementById('inpBudget').value || 50;
            localStorage.setItem('gioco_budget', monthlyBudget);
            updateDashboard();
        }

        function playSound(type) {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gainNode = ctx.createGain();
                osc.connect(gainNode);
                gainNode.connect(ctx.destination);
                
                if (type === 'win') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, ctx.currentTime);
                    osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.1);
                    osc.frequency.setValueAtTime(783.99, ctx.currentTime + 0.2);
                    gainNode.gain.setValueAtTime(0.1, ctx.currentTime);
                    gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.5);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.5);
                } else if (type === 'loss') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(300, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(100, ctx.currentTime + 0.3);
                    gainNode.gain.setValueAtTime(0.1, ctx.currentTime);
                    gainNode.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.3);
                }
            } catch(e) {}
        }

        function generateRecap() {
            const now = new Date();
            const currentMonth = now.getMonth();
            const currentYear = now.getFullYear();
            
            let count = 0, spent = 0, won = 0;
            let favGameCount = {'SuperEnalotto':0, 'Lotto':0, 'Gratta e Vinci':0};

            records.forEach(r => {
                const d = new Date(r.timestamp);
                if(d.getMonth() === currentMonth && d.getFullYear() === currentYear) {
                    count++;
                    spent += r.cost;
                    won += r.win;
                    favGameCount[r.type] = (favGameCount[r.type] || 0) + 1;
                }
            });

            if (count === 0) {
                alert("Nessuna giocata registrata in questo mese.");
                return;
            }

            const net = won - spent;
            const favGame = Object.keys(favGameCount).reduce((a, b) => favGameCount[a] > favGameCount[b] ? a : b);
            const months = ["Gennaio","Febbraio","Marzo","Aprile","Maggio","Giugno","Luglio","Agosto","Settembre","Ottobre","Novembre","Dicembre"];

            const msg = `📊 Riassunto di ${months[currentMonth]} ${currentYear}:\n\n- Giocate effettuate: ${count}\n- Spesa totale: €${spent.toFixed(2)}\n- Vincita totale: €${won.toFixed(2)}\n- Bilancio Netto: ${net >= 0 ? '+' : ''}€${net.toFixed(2)}\n- Gioco più frequente: ${favGame}`;
            alert(msg);
        }

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(records));
            const dlAnchorElem = document.createElement('a');
            dlAnchorElem.setAttribute("href", dataStr);
            dlAnchorElem.setAttribute("download", "gioco_live_backup.json");
            dlAnchorElem.click();
        }

        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (Array.isArray(imported)) {
                        records = imported;
                        localStorage.setItem('gioco_records', JSON.stringify(records));
                        updateDashboard();
                        alert('Dati importati con successo!');
                    }
                } catch (err) {
                    alert('Errore nel formato del file.');
                }
            };
            reader.readAsText(file);
        }

        function setGameType(type) {
            currentGame = type;
            document.getElementById('tabSuper').classList.toggle('active', type === 'SuperEnalotto');
            const tabLotto = document.getElementById('tabLotto');
            if(tabLotto) tabLotto.classList.toggle('active', type === 'Lotto');
            document.getElementById('tabGratta').classList.toggle('active', type === 'Gratta e Vinci');
            
            const genBox = document.getElementById('generatorBox');
            if(genBox) {
                if (type === 'Gratta e Vinci') {
                    genBox.style.display = 'none';
                } else {
                    genBox.style.display = 'block';
                    document.getElementById('slotNumbers').style.display = 'none';
                }
            }
        }

        function generateNumbers() {
            const container = document.getElementById('slotNumbers');
            container.style.display = 'flex';
            container.innerHTML = '';
            
            const count = currentGame === 'SuperEnalotto' ? 6 : 5;
            const elements = [];
            for(let i=0; i<count; i++) {
                const el = document.createElement('div');
                el.className = 'slot-number spinning';
                el.innerText = '00';
                container.appendChild(el);
                elements.push(el);
            }

            let spins = 0;
            const interval = setInterval(() => {
                elements.forEach(el => {
                    el.innerText = Math.floor(Math.random() * 90) + 1;
                });
                
                spins++;
                if(spins >= 20) {
                    clearInterval(interval);
                    const nums = new Set();
                    while(nums.size < count) {
                        nums.add(Math.floor(Math.random() * 90) + 1);
                    }
                    const sorted = Array.from(nums).sort((a,b) => a-b);
                    
                    elements.forEach((el, idx) => {
                        el.classList.remove('spinning');
                        el.innerText = sorted[idx];
                    });
                    
                    const ruote = ["Bari", "Cagliari", "Firenze", "Genova", "Milano", "Napoli", "Palermo", "Roma", "Torino", "Venezia", "Nazionale"];
                    const ruota = currentGame === 'Lotto' ? ' (Ruota: ' + ruote[Math.floor(Math.random()*ruote.length)] + ')' : '';
                    document.getElementById('inpDesc').value = 'Giocata Numeri: ' + sorted.join('-') + ruota;
                }
            }, 50);
        }

        function populateYearFilter() {
            const select = document.getElementById('globalYearFilter');
            if(!select) return;
            const currentVal = select.value || new Date().getFullYear().toString();
            
            const years = new Set();
            years.add(new Date().getFullYear());
            records.forEach(r => years.add(new Date(r.timestamp).getFullYear()));
            
            const sortedYears = Array.from(years).sort((a,b) => b - a);
            
            let html = '<option value="all">Tutti gli Anni</option>';
            sortedYears.forEach(y => {
                html += `<option value="${y}" ${y.toString() === currentVal ? 'selected' : ''}>${y}</option>`;
            });
            select.innerHTML = html;
        }

        function updateDashboard() {
            populateYearFilter();
            const select = document.getElementById('globalYearFilter');
            const selectedYear = select ? select.value : 'all';
            
            let activeRecords = records;
            if(selectedYear !== 'all') {
                activeRecords = records.filter(r => new Date(r.timestamp).getFullYear().toString() === selectedYear);
            }

            let totalCost = 0;
            let totalWin = 0;
            let spesaSE = 0;
            let spesaLotto = 0;
            let spesaGV = 0;
            let maxWin = 0;
            
            const now = new Date();
            const currentMonth = now.getMonth();
            const currentYear = now.getFullYear();
            let spentThisMonth = 0;

            let streak = 0;
            const chronological = [...activeRecords].sort((a,b) => a.timestamp - b.timestamp);
            for(let i = chronological.length - 1; i >= 0; i--) {
                const r = chronological[i];
                if(r.win - r.cost > 0) streak++;
                else break;
            }

            activeRecords.forEach(r => {
                const d = new Date(r.timestamp);
                if(d.getMonth() === currentMonth && d.getFullYear() === currentYear) {
                    spentThisMonth += parseFloat(r.cost);
                }
                const cost = parseFloat(r.cost);
                const win = parseFloat(r.win);
                totalCost += cost;
                totalWin += win;
                if (r.type === 'SuperEnalotto') spesaSE += cost;
                if (r.type === 'Lotto') spesaLotto += cost;
                if (r.type === 'Gratta e Vinci') spesaGV += cost;
                if (win > maxWin) maxWin = win;
            });

            const net = totalWin - totalCost;
            let roi = 0;
            if (totalCost > 0) roi = ((totalWin - totalCost) / totalCost) * 100;

            document.getElementById('valSpent').innerText = `€ ${totalCost.toFixed(2).replace('.', ',')}`;
            document.getElementById('valWon').innerText = `€ ${totalWin.toFixed(2).replace('.', ',')}`;
            
            const netEl = document.getElementById('valNet');
            netEl.innerText = `${net >= 0 ? '+' : ''}€ ${net.toFixed(2).replace('.', ',')}`;
            
            if(net > 0) netEl.style.color = 'var(--primary)';
            else if(net < 0) netEl.style.color = 'var(--danger)';
            else netEl.style.color = 'white';

            // Nuove statistiche
            document.getElementById('valSpesaSE').innerText = `€ ${spesaSE.toFixed(2).replace('.', ',')}`;
            const elLotto = document.getElementById('valSpesaLotto');
            if(elLotto) elLotto.innerText = `€ ${spesaLotto.toFixed(2).replace('.', ',')}`;
            document.getElementById('valSpesaGV').innerText = `€ ${spesaGV.toFixed(2).replace('.', ',')}`;
            document.getElementById('valMaxWin').innerText = `€ ${maxWin.toFixed(2).replace('.', ',')}`;
            const elStreak = document.getElementById('valStreak');
            if(elStreak) elStreak.innerText = `🔥 ${streak}`;

            // Aggiornamento barra budget
            const budgetPct = monthlyBudget > 0 ? (spentThisMonth / monthlyBudget) * 100 : 0;
            const elBudgetText = document.getElementById('budgetText');
            if (elBudgetText) {
                elBudgetText.innerText = `Spesa: € ${spentThisMonth.toFixed(2)} / € ${parseFloat(monthlyBudget).toFixed(2)}`;
                document.getElementById('budgetPercent').innerText = `${budgetPct.toFixed(1)}%`;
                const bar = document.getElementById('budgetBar');
                bar.style.width = Math.min(budgetPct, 100) + '%';
                if(budgetPct >= 100) bar.style.background = 'var(--danger)';
                else if(budgetPct >= 80) bar.style.background = 'var(--gold)';
                else bar.style.background = 'var(--primary)';
            }
            
            const roiEl = document.getElementById('valROI');
            roiEl.innerText = `${roi.toFixed(1)}%`;
            if (roi > 0) roiEl.style.color = 'var(--primary)';
            else if (roi < 0) roiEl.style.color = 'var(--danger)';
            else roiEl.style.color = 'white';

            renderHistory(activeRecords);
            updateChart(activeRecords);
        }

        function updateChart(activeRecords) {
            const ctx = document.getElementById('balanceChart').getContext('2d');
            const chronological = [...(activeRecords || records)].sort((a,b) => a.timestamp - b.timestamp);
            let currentBalance = 0;
            const labels = [];
            const data = [];

            chronological.forEach((r) => {
                currentBalance += (r.win - r.cost);
                labels.push(r.date.split(' ')[0]);
                data.push(currentBalance);
            });

            if (balanceChart) {
                balanceChart.destroy();
            }

            balanceChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Bilancio Netto Cumulativo (€)',
                        data: data,
                        borderColor: '#8b5cf6',
                        backgroundColor: 'rgba(139, 92, 246, 0.2)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointRadius: data.length > 50 ? 0 : 3,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            grid: { color: 'rgba(255,255,255,0.1)' },
                            ticks: { color: '#94a3b8' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#94a3b8', maxTicksLimit: 10 }
                        }
                    }
                }
            });
        }

        function renderHistory(activeRecords) {
            const list = document.getElementById('historyList');
            list.innerHTML = '';
            
            const filterType = document.getElementById('filterType') ? document.getElementById('filterType').value : 'all';
            let filtered = activeRecords || records;
            if (filterType !== 'all') {
                filtered = filtered.filter(r => r.type === filterType);
            }
            
            const sorted = [...filtered].reverse();

            if(sorted.length === 0) {
                list.innerHTML = '<li style="text-align:center; color:var(--text-muted); padding: 20px;">Nessuna giocata registrata.</li>';
                return;
            }

            sorted.forEach(r => {
                const net = r.win - r.cost;
                let statusClass = 'neutral';
                if(net > 0) statusClass = 'profit';
                if(net < 0) statusClass = 'loss';

                const badgeClass = r.type === 'SuperEnalotto' ? 'badge-superenalotto' : (r.type === 'Lotto' ? 'badge-lotto' : 'badge-gratta');
                
                const li = document.createElement('li');
                li.className = `history-item ${statusClass}`;
                li.innerHTML = `
                    <div class="history-info">
                        <strong>${r.date} <span class="type-badge ${badgeClass}">${r.type}</span></strong>
                        <span>${r.desc || 'Nessuna descrizione'}</span>
                    </div>
                    <div style="display:flex; align-items:center; gap: 15px;">
                        <div class="history-amounts">
                            <div style="font-size: 0.8rem; color: var(--text-muted)">Costo: €${r.cost.toFixed(2)} | Vincita: €${r.win.toFixed(2)}</div>
                            <div class="amt-net ${net > 0 ? 'positive' : (net < 0 ? 'negative' : '')}">
                                ${net >= 0 ? '+' : ''}€${net.toFixed(2)}
                            </div>
                        </div>
                        <div class="history-actions" style="display: flex; flex-direction: column; gap: 8px;">
                            <button type="button" onclick="editRecord(${r.timestamp})" style="background: var(--accent); border:none; color:white; cursor:pointer; border-radius:4px; padding: 5px 10px; font-size: 0.75rem; font-weight: bold; transition:0.2s;" title="Modifica">✏️ Modifica</button>
                            <button type="button" onclick="deleteRecord(${r.timestamp})" style="background: var(--danger); border:none; color:white; cursor:pointer; border-radius:4px; padding: 5px 10px; font-size: 0.75rem; font-weight: bold; transition:0.2s;" title="Elimina">🗑️ Elimina</button>
                        </div>
                    </div>
                `;
                list.appendChild(li);
            });
        }

        document.getElementById('gameForm').addEventListener('submit', (e) => {
            e.preventDefault();
            
            const cost = parseFloat(document.getElementById('inpCost').value) || 0;
            const win = parseFloat(document.getElementById('inpWin').value) || 0;
            const desc = document.getElementById('inpDesc').value;
            const dateVal = document.getElementById('inpDate').value;
            
            let dateObj = new Date();
            if(dateVal) {
                dateObj = new Date(dateVal);
            }
            
            const dateStr = dateObj.toLocaleDateString('it-IT') + ' ' + dateObj.toLocaleTimeString('it-IT', {hour: '2-digit', minute:'2-digit'});
            const newTimestamp = dateObj.getTime();

            if (editingTimestamp) {
                const idx = records.findIndex(x => x.timestamp === editingTimestamp);
                if (idx > -1) {
                    records[idx].type = currentGame;
                    records[idx].cost = cost;
                    records[idx].win = win;
                    records[idx].desc = desc;
                    records[idx].date = dateStr;
                    records[idx].timestamp = newTimestamp;
                }
            } else {
                records.push({
                    type: currentGame,
                    cost: cost,
                    win: win,
                    desc: desc,
                    date: dateStr,
                    timestamp: newTimestamp
                });
                if (win - cost > 0) playSound('win');
                else playSound('loss');
            }

            localStorage.setItem('gioco_records', JSON.stringify(records));
            
            resetForm();
            updateDashboard();
        });

        function editRecord(timestamp) {
            const r = records.find(x => x.timestamp === timestamp);
            if(!r) return;
            
            editingTimestamp = timestamp;
            setGameType(r.type);
            document.getElementById('inpDesc').value = r.desc || '';
            document.getElementById('inpCost').value = r.cost;
            document.getElementById('inpWin').value = r.win;
            
            const d = new Date(r.timestamp);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            document.getElementById('inpDate').value = d.toISOString().slice(0, 16);
            
            const btn = document.querySelector('#gameForm .btn-add');
            btn.innerHTML = '<i class="fa-solid fa-save"></i> Aggiorna Giocata';
            btn.style.background = 'linear-gradient(135deg, var(--primary), #059669)';
            btn.style.boxShadow = '0 4px 15px var(--primary-glow)';
        }

        function deleteRecord(timestamp) {
            if(confirm('Vuoi davvero eliminare questa giocata?')) {
                records = records.filter(x => x.timestamp !== timestamp);
                localStorage.setItem('gioco_records', JSON.stringify(records));
                updateDashboard();
                if (editingTimestamp === timestamp) {
                    resetForm();
                }
            }
        }

        function resetForm() {
            editingTimestamp = null;
            document.getElementById('gameForm').reset();
            document.getElementById('inpWin').value = 0;
            setCurrentDate();
            
            const btn = document.querySelector('#gameForm .btn-add');
            btn.innerHTML = '<i class="fa-solid fa-save"></i> Registra Giocata';
            btn.style.background = 'linear-gradient(135deg, var(--accent), #6d28d9)';
            btn.style.boxShadow = '0 4px 15px rgba(139, 92, 246, 0.4)';
        }

        function setCurrentDate() {
            const d = new Date();
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            document.getElementById('inpDate').value = d.toISOString().slice(0, 16);
        }

        // Initialize
        setCurrentDate();
        updateDashboard();

    </script>
</body>
</html>

